{
  "name": "@wyattjoh/fix-storage",
  "version": "0.1.0",
  "description": "See what is filling your Mac's disk, find the culprit, and clear what is safe to clear, from the terminal.",
  "keywords": [
    "bun",
    "cleanup",
    "cli",
    "disk",
    "disk-usage",
    "macos",
    "storage",
    "tui"
  ],
  "homepage": "https://github.com/wyattjoh/fix-storage#readme",
  "bugs": {
    "url": "https://github.com/wyattjoh/fix-storage/issues"
  },
  "license": "MIT",
  "author": "Wyatt Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/fix-storage.git"
  },
  "bin": {
    "fix-storage": "src/main.tsx"
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "demo": "HOME=/Users/you bun scripts/demo.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.9.7",
    "@opentui/react": "0.9.7",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
